<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reporte SSOMA - Backus AB InBev</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        backusYellow: '#FFCC00',
                        backusDark: '#121212',
                        backusCard: '#1E1E1E',
                    }
                }
            }
        }
    </script>
    <!-- Librerías para PDF y Captura de Imagen -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <style>
        /* Estilos específicos para impresión / exportación compacta */
        .export-mode {
            background-color: #ffffff !important;
            color: #000000 !important;
            border-color: #000000 !important;
            font-size: 10px !important;
        }
        .export-mode *, .export-mode input, .export-mode select, .export-mode textarea {
            color: #000000 !important;
            border-color: #999999 !important;
        }
        .export-mode input, .export-mode select, .export-mode textarea {
            background-color: #f9f9f9 !important;
            padding: 2px 4px !important;
            font-size: 10px !important;
        }
        .export-mode .bg-backusDark {
            background-color: #ffffff !important;
        }
        .export-mode .bg-backusCard {
            background-color: #ffffff !important;
        }
        .export-mode .bg-zinc-900 {
            background-color: #f3f4f6 !important;
        }
        .export-mode .text-zinc-400 {
            color: #4b5563 !important;
        }
        .export-mode .border-zinc-700 {
            border-color: #d1d5db !important;
        }
        .export-mode .text-backusYellow {
            color: #b45309 !important; /* Tono dorado/oscuro legible en blanco */
        }
        .export-mode .bg-backusYellow {
            background-color: #FFCC00 !important;
            color: #000000 !important;
            -webkit-print-color-adjust: exact;
        }
        .export-mode .no-export {
            display: none !important;
        }
        .export-mode .compact-container {
            padding: 4px !important;
            margin-bottom: 4px !important;
        }
        .export-mode h2 {
            font-size: 11px !important;
            padding-bottom: 2px !important;
            margin-bottom: 4px !important;
        }
        .export-mode label {
            font-size: 9px !important;
            margin-bottom: 1px !important;
        }
        .export-mode .grid-gap-compact {
            gap: 4px !important;
        }
    </style>
</head>
<body class="bg-backusDark text-white font-sans antialiased p-2 md:p-6">

    <div id="mainContainer" class="max-w-3xl mx-auto bg-backusCard border-2 border-backusYellow rounded-xl shadow-2xl overflow-hidden p-3 md:p-6 transition-all duration-300">
        
        <!-- Cabecera -->
        <div id="headerBox" class="bg-backusYellow text-backusDark p-3 text-center rounded mb-4">
            <h1 class="text-lg md:text-xl font-black tracking-wider uppercase">BACKUS AB INBEV</h1>
            <p class="text-xs font-bold mt-0.5">SISTEMA DE GESTIÓN SSOMA - PERMISO DE TRABAJO SEGURO (PTS)</p>
        </div>

        <!-- Formulario -->
        <form id="ssomaForm" class="space-y-3">

            <!-- Información sobre permiso -->
            <div class="border border-zinc-700 p-3 rounded-lg space-y-2 compact-container">
                <h2 class="text-backusYellow font-bold text-sm border-b border-zinc-700 pb-1">📋 Información sobre Permiso</h2>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
                    <div>
                        <label class="block text-xs font-semibold text-zinc-400 mb-0.5">NRO DE BITÁCORA *</label>
                        <input type="text" id="bitacora" required placeholder="Nro de Bitácora" class="w-full bg-zinc-900 border border-zinc-700 rounded p-1.5 text-backusYellow font-mono outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-zinc-400 mb-0.5">EMPRESA CONTRATISTA *</label>
                        <input type="text" id="contratista" required placeholder="Ej. Serviseg S.A.C." class="w-full bg-zinc-900 border border-zinc-700 rounded p-1.5 outline-none">
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
                    <div>
                        <label class="block text-xs font-semibold text-zinc-400 mb-0.5">NOMBRE DEL TRABAJO *</label>
                        <input type="text" id="nombreTrabajo" required placeholder="Ej. Mantenimiento preventivo" class="w-full bg-zinc-900 border border-zinc-700 rounded p-1.5 outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-zinc-400 mb-0.5">CLASE DE TRABAJO *</label>
                        <select id="claseTrabajo" class="w-full bg-zinc-900 border border-zinc-700 rounded p-1.5 outline-none">
                            <option value="INTERNO">INTERNO</option>
                            <option value="EXTERNO">EXTERNO</option>
                        </select>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-zinc-400 mb-0.5">DESCRIPCIÓN DEL PERMISO *</label>
                    <textarea id="descPermiso" rows="1" required placeholder="Detalle la actividad..." class="w-full bg-zinc-900 border border-zinc-700 rounded p-1.5 outline-none"></textarea>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
                    <div>
                        <label class="block text-xs font-semibold text-zinc-400 mb-0.5">ÁREA *</label>
                        <select id="area" onchange="actualizarSubareas()" class="w-full bg-zinc-900 border border-zinc-700 rounded p-1.5 outline-none">
                            <option value="CALIDAD">CALIDAD</option>
                            <option value="ELABORACION">ELABORACION</option>
                            <option value="GENTE">GENTE</option>
                            <option value="LOGISTICA">LOGISTICA</option>
                            <option value="MEDIO AMBIENTE">MEDIO AMBIENTE</option>
                            <option value="PACKAGING">PACKAGING</option>
                            <option value="TECHNICAL SERVICES">TECHNICAL SERVICES</option>
                            <option value="UTILITIES">UTILITIES</option>
                            <option value="OTRO">OTRO</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-zinc-400 mb-0.5">SUBÁREA *</label>
                        <select id="subarea" class="w-full bg-zinc-900 border border-zinc-700 rounded p-1.5 outline-none">
                            <!-- Se llena dinámicamente -->
                        </select>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-zinc-400 mb-0.5">DESCRIPCIÓN DEL LUGAR *</label>
                    <input type="text" id="lugar" required placeholder="Ej. Mezzanine Línea 2" class="w-full bg-zinc-900 border border-zinc-700 rounded p-1.5 outline-none">
                </div>
            </div>

            <!-- Certificado de Apoyo y Seguridad -->
            <div class="border border-zinc-700 p-3 rounded-lg space-y-2 compact-container">
                <h2 class="text-backusYellow font-bold text-sm border-b border-zinc-700 pb-1">🛡️ Certificados de Apoyo y N° de Permiso</h2>
                
                <div class="text-[10px] text-zinc-400 mb-1">Marque el certificado e ingrese su número correspondiente:</div>
                
                <!-- Lista de Certificados con campos de número individuales -->
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2 bg-zinc-900 p-2 rounded border border-zinc-700 text-xs">
                    
                    <div class="space-y-1 p-1 border border-zinc-800 rounded">
                        <label class="flex items-center space-x-1 cursor-pointer">
                            <input type="checkbox" name="cert_item" value="ACT. INMERSION" onchange="toggleCertInput(this, 'nro_act_inmersion')" class="accent-backusYellow"> 
                            <span class="font-bold text-[11px]">ACT. INVERSIÓN</span>
                        </label>
                        <input type="text" id="nro_act_inmersion" placeholder="N° Certificado" disabled class="w-full bg-zinc-950 border border-zinc-700 rounded p-1 text-[10px] text-white opacity-50 outline-none">
                    </div>

                    <div class="space-y-1 p-1 border border-zinc-800 rounded">
                        <label class="flex items-center space-x-1 cursor-pointer">
                            <input type="checkbox" name="cert_item" value="ALTURA" onchange="toggleCertInput(this, 'nro_altura')" class="accent-backusYellow"> 
                            <span class="font-bold text-[11px]">ALTURA</span>
                        </label>
                        <input type="text" id="nro_altura" placeholder="N° Certificado" disabled class="w-full bg-zinc-950 border border-zinc-700 rounded p-1 text-[10px] text-white opacity-50 outline-none">
                    </div>

                    <div class="space-y-1 p-1 border border-zinc-800 rounded">
                        <label class="flex items-center space-x-1 cursor-pointer">
                            <input type="checkbox" name="cert_item" value="CALIENTE" onchange="toggleCertInput(this, 'nro_caliente')" class="accent-backusYellow"> 
                            <span class="font-bold text-[11px]">CALIENTE</span>
                        </label>
                        <input type="text" id="nro_caliente" placeholder="N° Certificado" disabled class="w-full bg-zinc-950 border border-zinc-700 rounded p-1 text-[10px] text-white opacity-50 outline-none">
                    </div>

                    <div class="space-y-1 p-1 border border-zinc-800 rounded">
                        <label class="flex items-center space-x-1 cursor-pointer">
                            <input type="checkbox" name="cert_item" value="CONFINADO" onchange="toggleCertInput(this, 'nro_confinado')" class="accent-backusYellow"> 
                            <span class="font-bold text-[11px]">CONFINADO</span>
                        </label>
                        <input type="text" id="nro_confinado" placeholder="N° Certificado" disabled class="w-full bg-zinc-950 border border-zinc-700 rounded p-1 text-[10px] text-white opacity-50 outline-none">
                    </div>

                    <div class="space-y-1 p-1 border border-zinc-800 rounded">
                        <label class="flex items-center space-x-1 cursor-pointer">
                            <input type="checkbox" name="cert_item" value="DESHABILITACION DISP. SEGURIDAD" onchange="toggleCertInput(this, 'nro_deshab')" class="accent-backusYellow"> 
                            <span class="font-bold text-[11px]">DESHAB. SEGURIDAD</span>
                        </label>
                        <input type="text" id="nro_deshab" placeholder="N° Certificado" disabled class="w-full bg-zinc-950 border border-zinc-700 rounded p-1 text-[10px] text-white opacity-50 outline-none">
                    </div>

                    <div class="space-y-1 p-1 border border-zinc-800 rounded">
                        <label class="flex items-center space-x-1 cursor-pointer">
                            <input type="checkbox" name="cert_item" value="ENTRADA DE LINEA" onchange="toggleCertInput(this, 'nro_entrada')" class="accent-backusYellow"> 
                            <span class="font-bold text-[11px]">ENTRADA DE LÍNEA</span>
                        </label>
                        <input type="text" id="nro_entrada" placeholder="N° Certificado" disabled class="w-full bg-zinc-950 border border-zinc-700 rounded p-1 text-[10px] text-white opacity-50 outline-none">
                    </div>

                    <div class="space-y-1 p-1 border border-zinc-800 rounded">
                        <label class="flex items-center space-x-1 cursor-pointer">
                            <input type="checkbox" name="cert_item" value="INFRAESTRUCTURA" onchange="toggleCertInput(this, 'nro_infra')" class="accent-backusYellow"> 
                            <span class="font-bold text-[11px]">INFRAESTRUCTURA</span>
                        </label>
                        <input type="text" id="nro_infra" placeholder="N° Certificado" disabled class="w-full bg-zinc-950 border border-zinc-700 rounded p-1 text-[10px] text-white opacity-50 outline-none">
                    </div>

                    <div class="space-y-1 p-1 border border-zinc-800 rounded">
                        <label class="flex items-center space-x-1 cursor-pointer">
                            <input type="checkbox" name="cert_item" value="IZAJE EQUIPOS" onchange="toggleCertInput(this, 'nro_izaje_eq')" class="accent-backusYellow"> 
                            <span class="font-bold text-[11px]">IZAJE EQUIPOS</span>
                        </label>
                        <input type="text" id="nro_izaje_eq" placeholder="N° Certificado" disabled class="w-full bg-zinc-950 border border-zinc-700 rounded p-1 text-[10px] text-white opacity-50 outline-none">
                    </div>

                    <div class="space-y-1 p-1 border border-zinc-800 rounded">
                        <label class="flex items-center space-x-1 cursor-pointer">
                            <input type="checkbox" name="cert_item" value="IZAJE GRUAS" onchange="toggleCertInput(this, 'nro_izaje_gruas')" class="accent-backusYellow"> 
                            <span class="font-bold text-[11px]">IZAJE GRÚAS</span>
                        </label>
                        <input type="text" id="nro_izaje_gruas" placeholder="N° Certificado" disabled class="w-full bg-zinc-950 border border-zinc-700 rounded p-1 text-[10px] text-white opacity-50 outline-none">
                    </div>

                    <div class="space-y-1 p-1 border border-zinc-800 rounded">
                        <label class="flex items-center space-x-1 cursor-pointer">
                            <input type="checkbox" name="cert_item" value="LOTOTO" onchange="toggleCertInput(this, 'nro_lototo')" class="accent-backusYellow"> 
                            <span class="font-bold text-[11px]">LOTOTO</span>
                        </label>
                        <input type="text" id="nro_lototo" placeholder="N° Certificado" disabled class="w-full bg-zinc-950 border border-zinc-700 rounded p-1 text-[10px] text-white opacity-50 outline-none">
                    </div>

                    <div class="space-y-1 p-1 border border-zinc-800 rounded">
                        <label class="flex items-center space-x-1 cursor-pointer">
                            <input type="checkbox" name="cert_item" value="SUST. PELIGROSAS A GRANEL" onchange="toggleCertInput(this, 'nro_sust')" class="accent-backusYellow"> 
                            <span class="font-bold text-[11px]">SUST. PELIGROSAS</span>
                        </label>
                        <input type="text" id="nro_sust" placeholder="N° Certificado" disabled class="w-full bg-zinc-950 border border-zinc-700 rounded p-1 text-[10px] text-white opacity-50 outline-none">
                    </div>

                    <div class="space-y-1 p-1 border border-zinc-800 rounded bg-backusYellow/10">
                        <label class="flex items-center space-x-1 cursor-pointer">
                            <input type="checkbox" name="cert_item" value="TARJETA VERDE" onchange="toggleCertInput(this, 'nro_tarj_verde')" class="accent-backusYellow"> 
                            <span class="font-bold text-[11px] text-backusYellow">TARJETA VERDE</span>
                        </label>
                        <input type="text" id="nro_tarj_verde" placeholder="N° Tarjeta Verde" disabled class="w-full bg-zinc-950 border border-zinc-700 rounded p-1 text-[10px] text-white opacity-50 outline-none">
                    </div>

                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-2 pt-1">
                    <div>
                        <label class="block text-xs font-semibold text-zinc-400 mb-0.5">NRO DE TRABAJADORES *</label>
                        <input type="number" id="nroTrabajadores" min="1" value="1" required class="w-full bg-zinc-900 border border-zinc-700 rounded p-1.5 outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-zinc-400 mb-0.5">SUPERVISOR EJECUTANTE *</label>
                        <input type="text" id="supEjecutanteNombre" placeholder="Nombre" required class="w-full bg-zinc-900 border border-zinc-700 rounded p-1 mb-1 outline-none">
                        <select id="supEjecutanteTipo" class="w-full bg-zinc-900 border border-zinc-700 rounded p-0.5 text-[10px] outline-none">
                            <option value="Contratista">Contratista</option>
                            <option value="Backus">Backus</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-zinc-400 mb-0.5">SUPERVISOR OPERATIVO *</label>
                        <input type="text" id="supOperativo" placeholder="Nombre" required class="w-full bg-zinc-900 border border-zinc-700 rounded p-1.5 outline-none">
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-2">
                    <div>
                        <label class="block text-xs font-semibold text-zinc-400 mb-0.5">SUPERVISOR SSOMA *</label>
                        <input type="text" id="supSsoma" placeholder="Nombre SSOMA" required class="w-full bg-zinc-900 border border-zinc-700 rounded p-1.5 outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-zinc-400 mb-0.5">FECHA *</label>
                        <input type="date" id="fecha" required class="w-full bg-zinc-900 border border-zinc-700 rounded p-1.5 text-white outline-none">
                    </div>
                    <div class="grid grid-cols-2 gap-1">
                        <div>
                            <label class="block text-xs font-semibold text-zinc-400 mb-0.5">H. INICIO *</label>
                            <input type="time" id="hInicio" required class="w-full bg-zinc-900 border border-zinc-700 rounded p-1.5 text-white outline-none text-xs">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-zinc-400 mb-0.5">H. FINAL *</label>
                            <input type="time" id="hFinal" required class="w-full bg-zinc-900 border border-zinc-700 rounded p-1.5 text-white outline-none text-xs">
                        </div>
                    </div>
                </div>

                <!-- Autorizaciones -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-2 pt-1 border-t border-zinc-800">
                    <div>
                        <label class="block text-[11px] font-semibold text-backusYellow mb-0.5">AUTORIZACIÓN DEL ÁREA (BACKUS) *</label>
                        <input type="text" id="authAreaNombre" placeholder="Nombre del autorizador de área" required class="w-full bg-zinc-900 border border-zinc-700 rounded p-1.5 text-white outline-none">
                    </div>
                    <div>
                        <label class="block text-[11px] font-semibold text-backusYellow mb-0.5">AUTORIZADO FINAL (BACKUS) *</label>
                        <input type="text" id="authFinalNombre" placeholder="Nombre del autorizador final" required class="w-full bg-zinc-900 border border-zinc-700 rounded p-1.5 text-white outline-none">
                    </div>
                </div>
            </div>

            <!-- Botones de Acción (Se ocultan al exportar) -->
            <div id="actionButtons" class="flex flex-col md:flex-row gap-3 pt-2 no-export">
                <button type="button" onclick="descargarPDF()" class="flex-1 bg-backusYellow text-backusDark font-bold py-2.5 px-4 rounded hover:bg-yellow-400 transition uppercase tracking-wider text-xs shadow">
                    📄 Descargar PDF (1 Hoja)
                </button>
                <button type="button" onclick="descargarImagen()" class="flex-1 bg-zinc-800 text-backusYellow border border-backusYellow font-bold py-2.5 px-4 rounded hover:bg-zinc-700 transition uppercase tracking-wider text-xs">
                    📷 Descargar Imagen
                </button>
                <button type="button" onclick="enviarWhatsApp()" class="flex-1 bg-green-600 text-white font-bold py-2.5 px-4 rounded hover:bg-green-500 transition uppercase tracking-wider text-xs">
                    💬 Enviar WhatsApp
                </button>
            </div>

        </form>
    </div>

    <!-- Scripts de Lógica -->
    <script>
        document.getElementById('fecha').valueAsDate = new Date();

        const subareasData = {
            "CALIDAD": ["ALACENES / LABORATORIO DE CALIDAD", "LABORATORIO DE ENVASADO"],
            "ELABORACION": ["BLOQUE FRIO", "BLOQUE FRIO CIP", "COCIMIENTOS", "COCIMIENTOS CIP", "COPRODUCTOS", "FILTRACION", "OTROS"],
            "GENTE": ["AREAS COMUNES", "BAÑOS", "CENTRO DE ENTRETENIMIENTO", "COCINA Y RESTAURANTE", "ESTACIONAMIENTOS", "OFICINAS", "OFICINAS GENTE", "RESTAURANTE", "SERVICIO MEDICO", "OTROS"],
            "LOGISTICA": ["ALMACEN", "ALMACEN DE MATERIA PRIMA", "LOGISTICA", "MAQUINAS", "OFICINA LOGISTICA", "TALLER", "OTROS"],
            "MEDIO AMBIENTE": ["BTS", "MEDIO AMBIENTE", "OFICINAS MEDIO AMBIENTE", "OTROS"],
            "PACKAGING": ["LINEA 1", "LINEA 2", "OFICINAS DE ENVASADO", "TALLER DE MANTENIMIENTO", "CUARTO DE LUBRICACION", "OTROS"],
            "TECHNICAL SERVICES": ["TALLER DE MANTENIMIENTO"],
            "UTILITIES": ["CALDERAS", "ELECTRICA", "MAQUINARIA", "OFICINAS", "PLANTA CO2", "PLANTA DE REFRIGERACION", "SERVICIOS Y ENERGIA", "OTROS"],
            "OTRO": ["GENERAL PLANTA"]
        };

        function actualizarSubareas() {
            const area = document.getElementById('area').value;
            const subareaSelect = document.getElementById('subarea');
            subareaSelect.innerHTML = '';
            
            const opciones = subareasData[area] || ["GENERAL PLANTA"];
            opciones.forEach(sub => {
                const opt = document.createElement('option');
                opt.value = sub;
                opt.textContent = sub;
                subareaSelect.appendChild(opt);
            });
        }
        actualizarSubareas();

        function toggleCertInput(checkbox, inputId) {
            const inputField = document.getElementById(inputId);
            if (checkbox.checked) {
                inputField.disabled = false;
                inputField.classList.remove('opacity-50');
                inputField.focus();
            } else {
                inputField.disabled = true;
                inputField.classList.add('opacity-50');
                inputField.value = '';
            }
        }

        function obtenerCertificadosSeleccionados() {
            const checkboxes = document.querySelectorAll('input[name="cert_item"]:checked');
            let lista = [];
            checkboxes.forEach(cb => {
                const inputId = cb.onchange.toString().match(/'([^']+)'/)[1];
                const nroVal = document.getElementById(inputId).value;
                lista.push(`${cb.value} ${nroVal ? '[N°: ' + nroVal + ']' : ''}`);
            });
            return lista.length > 0 ? lista.join(', ') : 'NINGUNO';
        }

        function generarTextoResumen() {
            return `*REPORTE SSOMA - BACKUS AB INBEV*` +
                   `\n*Bitácora:* ${document.getElementById('bitacora').value || 'N/A'}` +
                   `\n*Contratista:* ${document.getElementById('contratista').value}` +
                   `\n*Trabajo:* ${document.getElementById('nombreTrabajo').value} (${document.getElementById('claseTrabajo').value})` +
                   `\n*Área:* ${document.getElementById('area').value} -> ${document.getElementById('subarea').value}` +
                   `\n*Lugar:* ${document.getElementById('lugar').value}` +
                   `\n*Certificados:* ${obtenerCertificadosSeleccionados()}` +
                   `\n*Nro Trabajadores:* ${document.getElementById('nroTrabajadores').value}` +
                   `\n*Sup. Ejecutante:* ${document.getElementById('supEjecutanteNombre').value} (${document.getElementById('supEjecutanteTipo').value})` +
                   `\n*Sup. Operativo:* ${document.getElementById('supOperativo').value}` +
                   `\n*Sup. SSOMA:* ${document.getElementById('supSsoma').value}` +
                   `\n*Fecha / Hora:* ${document.getElementById('fecha').value} [${document.getElementById('hInicio').value} - ${document.getElementById('hFinal').value}]` +
                   `\n*Autoriza Área:* ${document.getElementById('authAreaNombre').value}` +
                   `\n*Autorizado Final:* ${document.getElementById('authFinalNombre').value}`;
        }

        function descargarPDF() {
            const elemento = document.getElementById('mainContainer');
            const bitacoraVal = document.getElementById('bitacora').value || 'SIN_NUMERO';
            
            // Activar modo claro / compacto para que entre en 1 sola hoja A4
            elemento.classList.add('export-mode');

            const opciones = {
                margin:       5,
                filename:     `Reporte_SSOMA_${bitacoraVal}.pdf`,
                image:        { type: 'jpeg', quality: 0.98 },
                html2canvas:  { scale: 2, useCORS: true, backgroundColor: '#ffffff' },
                jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' }
            };

            html2pdf().from(elemento).set(opciones).save().then(() => {
                elemento.classList.remove('export-mode');
            });
        }

        function descargarImagen() {
            const elemento = document.getElementById('mainContainer');
            const bitacoraVal = document.getElementById('bitacora').value || 'SIN_NUMERO';
            
            elemento.classList.add('export-mode');

            html2canvas(elemento, { scale: 2, backgroundColor: '#ffffff', useCORS: true }).then(canvas => {
                const enlace = document.createElement('a');
                enlace.download = `Reporte_SSOMA_${bitacoraVal}.png`;
                enlace.href = canvas.toDataURL('image/png');
                enlace.click();
                elemento.classList.remove('export-mode');
            });
        }

        function enviarWhatsApp() {
            const texto = encodeURIComponent(generarTextoResumen());
            window.open(`https://wa.me/?text=${texto}`, '_blank');
        }
    </script>
</body>
</html>
